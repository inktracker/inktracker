<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  ACTIVE since build 4 (2026-08-31): CODE_SIGN_ENTITLEMENTS is set on the
	  App target and both capabilities (Push Notifications + Associated
	  Domains) are enabled on App ID app.inktracker.mobile via the ASC API.

	  aps-environment: APNs push for @mention/order notifications. The
	  sendPush edge function delivers to device tokens registered by
	  src/lib/push/nativePush.js.

	  Associated domains: universal-link return path for QuickBooks OAuth
	  (Intuit requires https redirects). Both hosts because QB OAuth returns
	  to the apex while Supabase auth returns to www.
	-->
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:inktracker.app</string>
		<string>applinks:www.inktracker.app</string>
	</array>
</dict>
</plist>
